# Copy to .env.local (ignored by git) for local development.
# In production, set it in Vercel > Project > Settings > Environment Variables, then redeploy.
# Value: "URL do endpoint" of the form in Odoo (CRM > Configuração > Formulários externos).
# Empty or missing: the form only opens WhatsApp, no lead is created in Odoo.
VITE_LEAD_ENDPOINT=https://SEU-PROJETO.odoo.com/crm/external-form/CHAVE-DO-FORMULARIO
